export CLAUDE_CODE_USE_VERTEX=1
export ANTHROPIC_VERTEX_PROJECT_ID=${ANTHROPIC_VERTEX_PROJECT_ID}
export CLOUD_ML_REGION=${CLOUD_ML_REGION}
export GOOGLE_CLOUD_PROJECT=${GOOGLE_CLOUD_PROJECT}
# Sandbox path: harness mounts ${GOOGLE_APPLICATION_CREDENTIALS} here.
# Do not use a host filesystem path — ADC will miss the key and probe GCE metadata.
export GOOGLE_APPLICATION_CREDENTIALS=/tmp/.gcp-credentials.json
# Skip GCE/GKE metadata detection (169.254.169.254 / metadata.google.internal).
# Those endpoints are blocked by sandbox policy and are not needed with a key file.
export NO_GCE_CHECK=true
export METADATA_SERVER_DETECTION=none
